<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left Column: Interactive Month Calendar -->
    <LinearLayout
        android:id="@+id/widget_calendar_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <!-- Month Navigation Header: <  MONTH YEAR  > -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_prev_month"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_circle_button"
                android:gravity="center"
                android:text="‹"
                android:textColor="#C4C7C8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="OCTOBER 2026"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_btn_next_month"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_circle_button"
                android:gravity="center"
                android:text="›"
                android:textColor="#C4C7C8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Weekday Labels: S M T W T F S -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="S"
                android:textColor="#8E8E93"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="M"
                android:textColor="#C4C7C8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="T"
                android:textColor="#C4C7C8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="W"
                android:textColor="#C4C7C8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="T"
                android:textColor="#C4C7C8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="F"
                android:textColor="#C4C7C8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="S"
                android:textColor="#8E8E93"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 6x7 Month Grid -->
        <!-- Row 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_0_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_0_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_0_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_0_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_0_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_0_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_0_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
        </LinearLayout>

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_1_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_1_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_1_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_1_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_1_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_1_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_1_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_2_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_2_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_2_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_2_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_2_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_2_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_2_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_3_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_3_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_3_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_3_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_3_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_3_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_3_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_4_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_4_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_4_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_4_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_4_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_4_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_4_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/day_5_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_5_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_5_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_5_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_5_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_5_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
            <TextView android:id="@+id/day_5_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10.5sp" android:textColor="#EDEDED" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle Vertical Divider -->
    <FrameLayout
        android:id="@+id/widget_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:background="#222222" />

    <!-- Right Column: Selected Date Agenda & Action Header -->
    <LinearLayout
        android:id="@+id/widget_agenda_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:orientation="vertical">

        <!-- Header: Date Title and Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="16 OCT."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Add Event Button -->
            <ImageView
                android:id="@+id/widget_btn_add_event"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_circle_button"
                android:contentDescription="@string/add_event"
                android:padding="5dp"
                android:src="@drawable/ic_widget_add_event" />

            <!-- Add Memory Button -->
            <ImageView
                android:id="@+id/widget_btn_add_memory"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_circle_button"
                android:contentDescription="@string/add_memory"
                android:padding="5dp"
                android:src="@drawable/ic_widget_add_memory" />
        </LinearLayout>

        <!-- Events List Container (TOP ALIGNED) -->
        <LinearLayout
            android:id="@+id/widget_events_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical">

            <!-- Event 1 -->
            <LinearLayout
                android:id="@+id/event_1_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_event_dot" />

                <TextView
                    android:id="@+id/event_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/event_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E5E2E1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Event 2 -->
            <LinearLayout
                android:id="@+id/event_2_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_event_dot" />

                <TextView
                    android:id="@+id/event_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/event_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E5E2E1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Event 3 -->
            <LinearLayout
                android:id="@+id/event_3_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_event_dot" />

                <TextView
                    android:id="@+id/event_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/event_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E5E2E1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Event 4 -->
            <LinearLayout
                android:id="@+id/event_4_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_event_dot" />

                <TextView
                    android:id="@+id/event_4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/event_4_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E5E2E1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Selected Day's Memory Highlight Row -->
            <LinearLayout
                android:id="@+id/widget_memory_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/widget_memory_dot" />

                <TextView
                    android:id="@+id/widget_memory_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C8C6C9"
                    android:textSize="10sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State Container (TOP ALIGNED) -->
        <LinearLayout
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_events"
                android:textColor="#E5E2E1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/enjoy_day"
                android:textColor="#8E8E93"
                android:textSize="10sp" />

            <!-- Empty state memory row if events are 0 but a memory was created on this date -->
            <LinearLayout
                android:id="@+id/widget_empty_memory_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/widget_memory_dot" />

                <TextView
                    android:id="@+id/widget_empty_memory_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#C8C6C9"
                    android:textSize="10sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
