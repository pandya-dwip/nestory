# Flutter's auto-generated multi-platform scaffolding. Nestory ships on
# Android only; these folders are untouched `flutter create` boilerplate
# (C++/CMake runners, Swift app delegates, etc.) kept only so the project
# still builds if another platform is ever enabled. Excluded from GitHub's
# language stats since none of it is hand-written app code.
/android/**  linguist-vendored
/ios/**      linguist-vendored
/linux/**    linguist-vendored
/macos/**    linguist-vendored
/windows/**  linguist-vendored
/web/**      linguist-vendored

